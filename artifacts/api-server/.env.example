# Port
PORT=8080

# Database URL (PostgreSQL required)
# e.g., local PostgreSQL or Supabase/Neon/Railway
DATABASE_URL=postgresql://postgres:password@localhost:5432/jobblast

# AI Tailoring (Optional)
# Gemini API Key for RAG resume tailoring
GEMINI_API_KEY=your_gemini_api_key_here

